# 编译产物：out-of-source → build/(手动 make) 或 result/<时间戳>/build/(run_all.sh)。
# "build/" 匹配任意层级的 build 目录，代码目录 kernels/ 不再产生任何产物。
*.o
build/

# Nsight 报告（H20 参考基线的 .ncu-rep 保留入库；A800 的本地生成，只留 details.txt 文本）
baselines/**/*.run.log
baselines/a800/*.ncu-rep

# run_all.sh 结果：保留每次执行日志(.log/.txt/.md/.tsv/遥测)，只忽略移动软链与 ncu 二进制
result/latest
result/**/*.ncu-rep
result/**/*.run.log

# Python 缓存（scripts/gpu_specs.py 被 import 时产生）
__pycache__/
*.pyc

# Modal 本地拉取的跨机型结果（体积可能较大，按需入库精选）
result/**/*_modal/**/*.ncu-rep

# 编辑器/系统
.vscode/
.cache/
*.swp
.DS_Store
