# 编译产物：out-of-source → build/(手动 make) 或 result/<时间戳>/build/(run_all.sh)。
# "build/" 匹配任意层级的 build 目录，代码目录 kernels/ 不再产生任何产物。
*.o
build/

# Nsight 报告（大二进制；文本 details/SUMMARY 保留入库）
#*.ncu-rep
#*.nsys-rep
profiling/**/*.run.log
# A800 ncu 二进制本地生成；文本 details/SUMMARY 已入库
profiling/a800/*.ncu-rep

# run_all.sh 结果：保留每次执行日志(.log/.txt/.md/.tsv/遥测)，只忽略移动软链与 ncu 二进制
result/latest
result/**/*.ncu-rep

# 编辑器/系统
.vscode/
.cache/
*.swp
.DS_Store
